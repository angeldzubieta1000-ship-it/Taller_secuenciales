Algoritmo FuncionesMatematicas
	Definir num Como Real
	Escribir "ingrese un numero:"
	Leer num
	escribir "El valor de seno es:", SEN(num)
	escribir "El valor de coseno es:", COS(num)
	escribir "El valor de tangente es:",TAN(num)
	Escribir "El valor de raiz es:", rc(num)
	Escribir "El valor de logaritmoNatural:", ln(num)
	Escribir "El valor de logaritmoBase10:", ln(num)/10
FinAlgoritmo
